{
  "name": "zipcode-tools",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "wrangler pages deploy .vercel/output/static",
    "pages:dev": "npx wrangler pages dev .vercel/output/static --compatibility-flag=nodejs_compat",
    "db:migrate:local": "wrangler d1 execute zipcodes-db --local --file=./migrations/0001_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute zipcodes-db --local --file=./data/seed/seed_data.sql",
    "db:migrate:remote": "wrangler d1 execute zipcodes-db --remote --file=./migrations/0001_initial_schema.sql",
    "db:seed:remote": "wrangler d1 execute zipcodes-db --remote --file=./data/seed/seed_data.sql",
    "db:sync:remote": "node scripts/sync-d1-remote.mjs --target=remote --all",
    "db:sync:remote:vn": "node scripts/sync-d1-remote.mjs --target=remote --vn-only",
    "db:sync:local": "node scripts/sync-d1-remote.mjs --target=local --all",
    "db:export:chunks": "node scripts/sync-d1-remote.mjs --export-only --all",
    "db:fetch-real": "node scripts/fetch-real-data.mjs",
    "db:fetch-real:all": "node scripts/fetch-real-data.mjs --all"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.7",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^20.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5",
    "wrangler": "^3.91.0"
  }
}
